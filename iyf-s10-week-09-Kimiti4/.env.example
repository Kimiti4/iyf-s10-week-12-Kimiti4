# Frontend Environment Variables
# Copy this file to .env and fill in your actual values.

# API Configuration
# Local development:
# VITE_API_URL=http://localhost:3001/api

# Production: set this to the deployed Express API origin + /api.
VITE_API_URL=https://your-backend-host.example.com/api

# Socket.IO Backend URL
# Set this to the deployed backend origin when realtime is enabled.
VITE_BACKEND_URL=https://your-backend-host.example.com

# Optional frontend monitoring
# VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# Deployment note:
# The backend uses PostgreSQL through DATABASE_URL. The frontend does not
# connect directly to PostgreSQL; all application data access goes through
# the Express API.
