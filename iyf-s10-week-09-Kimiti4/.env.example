# Frontend Environment Variables
# ⚠️ Copy this to .env. VITE_ vars are embedded at build time.

# API base URL (your Render backend)
VITE_API_URL=https://your-jamiilink-api.onrender.com/api

# Socket.IO backend URL (same host, no /api)
VITE_BACKEND_URL=https://your-jamiilink-api.onrender.com

# Sentry (optional)
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
