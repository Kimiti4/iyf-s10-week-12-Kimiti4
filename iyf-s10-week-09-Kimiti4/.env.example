# Frontend Environment Variables
# ⚠️ IMPORTANT: Copy this to .env and fill in your actual values

# API Configuration
# For local development, use localhost
#VITE_API_URL=http://localhost:3001/api

# For production, point to your Express backend host
# Backend DB: Supabase Postgres
# Backend host: Render / Railway / Fly / etc. (must support WebSockets)
VITE_API_URL=https://your-backend-host.example.com/api

# Socket.IO Backend URL
VITE_BACKEND_URL=https://your-backend-host.example.com

# Optional frontend monitoring
# VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
