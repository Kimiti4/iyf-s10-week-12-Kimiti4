# Backend Environment Variables
# ⚠️ Copy this to .env and fill in real values. NEVER commit .env with real credentials.

# Server
PORT=3001
NODE_ENV=production
CORS_ORIGIN=https://your-app.vercel.app
LOG_LEVEL=info

# Supabase PostgreSQL
# Dashboard → Settings → Database → Connection string → URI
# Format: postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# JWT
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=generate_a_secure_random_string
JWT_EXPIRES_IN=7d

# Demo token (frontend testing)
DEMO_TOKEN=jamii-demo-2026

# Tiannara AI (optional, leave blank if not using)
TIANNARA_API_URL=

# SMS fallback (optional)
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=JamiiLink

# Monitoring (optional)
SENTRY_BACKEND_DSN=
