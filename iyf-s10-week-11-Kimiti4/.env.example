# Backend Environment Variables
# ⚠️ IMPORTANT: Copy this to .env and fill in your actual values
# NEVER commit .env files with real credentials!

# Server Configuration
PORT=3001
NODE_ENV=production
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Database Configuration
# Supabase PostgreSQL connection string
# Use the direct connection (port 5432) for Render/Railway/Fly
# Use the pooler (port 6543) only for serverless functions
# Format: postgresql://postgres:YOUR_PASSWORD@db.<project-ref>.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# JWT Authentication
# Generate secure secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Set this in Railway Dashboard for production!
JWT_SECRET=your_secure_random_secret_here
JWT_EXPIRES_IN=7d

# Demo Token (for frontend testing)
DEMO_TOKEN=jamii-demo-2026

# Tiannara Core Integration (AI Moderation Service)
TIANNARA_API_URL=http://localhost:8000

# Optional SMS fallback (Africa's Talking)
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=JamiiLink

# Optional backend monitoring
SENTRY_BACKEND_DSN=
