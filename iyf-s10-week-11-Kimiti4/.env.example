# Backend Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env files with real credentials.

# Server
PORT=3001
NODE_ENV=development
# Browser origin allowed to call the API. Set this to the exact deployed frontend origin in production.
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# PostgreSQL
# Supabase-compatible PostgreSQL is supported. Do not commit a URL containing a real password.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# JWT
# Generate a strong secret, for example:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Demo Token (development/testing only; do not use as a production credential)
DEMO_TOKEN=replace_with_dev_only_demo_token

# Optional Tiannara Core integration
TIANNARA_API_URL=http://localhost:8000

# Optional SMS fallback (Africa's Talking)
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=JamiiLink

# Optional backend monitoring
SENTRY_BACKEND_DSN=
